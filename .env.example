# Copy to .env and edit. One file serves both ways of running the platform.

# --- `pnpm run api` (development, with the Postgres from apps/api/README.md) ---
DATABASE_URL=postgres://av2i:av2i@127.0.0.1:55432/av2i

# --- `docker compose up -d` ---
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# Optional: the first password of the `admin` account. Empty means `admin`, which must be changed at the first sign in.
ADMIN_INITIAL_PASSWORD=
# true when a reverse proxy terminates HTTPS in front of the platform (makes the cookie Secure and reads the client address)
TRUST_PROXY=false
PORT=3000
# Encrypts OpenTofu state and stored plans: `openssl rand -base64 32`. Keep a copy somewhere safe; without it the state cannot be read.
STATE_ENCRYPTION_KEY=

# --- AWS identity of the server (DD-023, DD-025) ---
# It is only used to assume the role of a project's AWS connection (page "AWS connections"); the tofu process never gets it.
# For development without a connection: RUN_WITH_SERVER_IDENTITY=true runs a project as the server itself.
# RUN_WITH_SERVER_IDENTITY=false
# Fill these in and restart the API. Leave them commented out until you have a key: an EMPTY value is not the same as an unset one.
# On AWS itself use an instance role instead and leave all of these out. Elsewhere use a dedicated IAM user that may only call sts:AssumeRole.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# only when the key is temporary (SSO, assume-role):
# AWS_SESSION_TOKEN=
# the designs set their own region; this is only for tools that need a default
# AWS_REGION=ap-southeast-1
