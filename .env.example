# Copy to .env and edit. One file serves both ways of running the platform.

# --- `pnpm run api` (development, with the Postgres from apps/api/README.md) ---
DATABASE_URL=postgres://av2i:av2i@127.0.0.1:55432/av2i

# --- `docker compose up -d` ---
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# Optional: the first password of the `admin` account. Empty means `admin`, which must be changed at the first sign in.
ADMIN_INITIAL_PASSWORD=
# true when a reverse proxy terminates HTTPS in front of the platform (makes the cookie Secure and reads the client address)
TRUST_PROXY=false
PORT=3000
# Encrypts OpenTofu state and stored plans: `openssl rand -base64 32`. Keep a copy somewhere safe; without it the state cannot be read.
STATE_ENCRYPTION_KEY=
