{
  "schema": 1,
  "name": "serverless-backend",
  "settings": {
    "region": "ap-southeast-1"
  },
  "nodes": [
    {
      "key": "vpc",
      "label": "API",
      "service": "vpc",
      "props": {
        "cidr_block": "10.4.0.0/16",
        "enable_dns_support": true,
        "enable_dns_hostnames": true
      }
    },
    {
      "key": "igw",
      "label": "Internet gateway",
      "service": "internet-gateway",
      "parent": "vpc",
      "props": {}
    },
    {
      "key": "pub_a",
      "label": "Public A",
      "service": "subnet",
      "parent": "vpc",
      "props": {
        "cidr_block": "10.4.0.0/24",
        "availability_zone": "ap-southeast-1a"
      }
    },
    {
      "key": "pub_b",
      "label": "Public B",
      "service": "subnet",
      "parent": "vpc",
      "props": {
        "cidr_block": "10.4.1.0/24",
        "availability_zone": "ap-southeast-1b"
      }
    },
    {
      "key": "priv_a",
      "label": "Private A",
      "service": "subnet",
      "parent": "vpc",
      "props": {
        "cidr_block": "10.4.10.0/24",
        "availability_zone": "ap-southeast-1a"
      }
    },
    {
      "key": "priv_b",
      "label": "Private B",
      "service": "subnet",
      "parent": "vpc",
      "props": {
        "cidr_block": "10.4.11.0/24",
        "availability_zone": "ap-southeast-1b"
      }
    },
    {
      "key": "rt_public",
      "label": "Public routes",
      "service": "route-table",
      "parent": "vpc",
      "props": {}
    },
    {
      "key": "rt_priv",
      "label": "Private routes",
      "service": "route-table",
      "parent": "vpc",
      "props": {}
    },
    {
      "key": "s3ep",
      "label": "S3 endpoint",
      "service": "vpc-endpoint-s3",
      "parent": "vpc",
      "props": {
        "policy": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": "*",
              "Action": [
                "s3:GetObject",
                "s3:PutObject"
              ],
              "Resource": [
                "arn:aws:s3:::av2i-example-uploads/*"
              ]
            }
          ]
        }
      }
    },
    {
      "key": "sg_alb",
      "label": "alb-sg",
      "service": "security-group",
      "parent": "vpc",
      "props": {
        "name": "alb-sg",
        "description": "Load balancer",
        "ingress_rules": [
          {
            "ip_protocol": "tcp",
            "from_port": 80,
            "to_port": 80,
            "cidr_ipv4": "0.0.0.0/0"
          },
          {
            "ip_protocol": "tcp",
            "from_port": 443,
            "to_port": 443,
            "cidr_ipv4": "0.0.0.0/0"
          }
        ]
      }
    },
    {
      "key": "sg_fn",
      "label": "fn-sg",
      "service": "security-group",
      "parent": "vpc",
      "props": {
        "name": "fn-sg",
        "description": "Data function"
      }
    },
    {
      "key": "sg_db",
      "label": "db-sg",
      "service": "security-group",
      "parent": "vpc",
      "props": {
        "name": "db-sg",
        "description": "Database"
      }
    },
    {
      "key": "alb",
      "label": "API ALB",
      "service": "alb",
      "parent": "pub_a",
      "props": {
        "name": "api-alb",
        "drop_invalid_header_fields": true,
        "enable_deletion_protection": true,
        "listeners": [
          {
            "port": 443,
            "protocol": "HTTPS",
            "ssl_policy": "ELBSecurityPolicy-TLS13-1-2-2021-06",
            "default_action": {
              "type": "forward"
            }
          },
          {
            "port": 80,
            "protocol": "HTTP",
            "default_action": {
              "type": "redirect",
              "status_code": "HTTP_301",
              "port": "443",
              "protocol": "HTTPS"
            }
          }
        ]
      }
    },
    {
      "key": "cert",
      "label": "Certificate",
      "service": "acm",
      "props": {
        "domain_name": "api.example.com",
        "validation_method": "DNS"
      }
    },
    {
      "key": "zone",
      "label": "example.com",
      "service": "route53",
      "props": {
        "name": "example.com"
      }
    },
    {
      "key": "edge_fn",
      "label": "Edge function",
      "service": "lambda",
      "props": {
        "function_name": "edge",
        "filename": "edge.zip",
        "handler": "index.handler",
        "runtime": "nodejs22.x"
      }
    },
    {
      "key": "data_fn",
      "label": "Data function",
      "service": "lambda",
      "parent": "priv_a",
      "props": {
        "function_name": "data",
        "image_tag": "v1",
        "timeout": 30
      }
    },
    {
      "key": "repo",
      "label": "Images",
      "service": "ecr",
      "props": {
        "name": "data-fn",
        "image_tag_mutability": "IMMUTABLE",
        "image_scanning_configuration": {
          "scan_on_push": true
        }
      }
    },
    {
      "key": "db_group",
      "label": "Database subnets",
      "service": "db-subnet-group",
      "parent": "vpc",
      "props": {
        "name": "data-db"
      }
    },
    {
      "key": "db",
      "label": "Database",
      "service": "rds",
      "parent": "vpc",
      "props": {
        "engine": "postgres",
        "instance_class": "db.t3.micro",
        "allocated_storage": 20,
        "username": "app",
        "deletion_protection": true
      }
    },
    {
      "key": "uploads",
      "label": "Uploads",
      "service": "s3",
      "props": {
        "bucket": "av2i-example-uploads"
      }
    },
    {
      "key": "data_role",
      "label": "Data role",
      "service": "iam-role",
      "props": {
        "name": "api-data",
        "managed_policies": [
          "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole",
          "arn:aws:iam::aws:policy/service-role/AWSLambdaVPCAccessExecutionRole"
        ]
      }
    },
    {
      "key": "audit",
      "label": "Audit metrics",
      "service": "iam-policy",
      "props": {
        "name": "api-audit",
        "description": "Publish metrics",
        "policy": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": [
                "cloudwatch:PutMetricData"
              ],
              "Resource": "*",
              "Condition": {
                "StringEquals": {
                  "cloudwatch:namespace": "Backend"
                }
              }
            }
          ]
        }
      }
    }
  ],
  "edges": [
    {
      "id": "e_rt_public_igw",
      "mechanism": "route",
      "from": "rt_public",
      "to": "igw",
      "props": {
        "destination_cidr_block": "0.0.0.0/0"
      }
    },
    {
      "id": "e_rt_public_a",
      "mechanism": "route-association",
      "from": "rt_public",
      "to": "pub_a"
    },
    {
      "id": "e_rt_public_b",
      "mechanism": "route-association",
      "from": "rt_public",
      "to": "pub_b"
    },
    {
      "id": "e_rt_priv_s3",
      "mechanism": "route",
      "from": "rt_priv",
      "to": "s3ep"
    },
    {
      "id": "e_rt_priv_a",
      "mechanism": "route-association",
      "from": "rt_priv",
      "to": "priv_a"
    },
    {
      "id": "e_rt_priv_b",
      "mechanism": "route-association",
      "from": "rt_priv",
      "to": "priv_b"
    },
    {
      "id": "e_alb_b",
      "mechanism": "containment",
      "from": "pub_b",
      "to": "alb"
    },
    {
      "id": "e_fn_b",
      "mechanism": "containment",
      "from": "priv_b",
      "to": "data_fn"
    },
    {
      "id": "e_dbg_a",
      "mechanism": "containment",
      "from": "priv_a",
      "to": "db_group"
    },
    {
      "id": "e_dbg_b",
      "mechanism": "containment",
      "from": "priv_b",
      "to": "db_group"
    },
    {
      "id": "e_db_group",
      "mechanism": "db-subnet-group",
      "from": "db",
      "to": "db_group"
    },
    {
      "id": "e_sg_alb",
      "mechanism": "sg-attach",
      "from": "sg_alb",
      "to": "alb"
    },
    {
      "id": "e_sg_fn",
      "mechanism": "sg-attach",
      "from": "sg_fn",
      "to": "data_fn"
    },
    {
      "id": "e_sg_db",
      "mechanism": "sg-attach",
      "from": "sg_db",
      "to": "db"
    },
    {
      "id": "e_alb_edge",
      "mechanism": "listener-target",
      "from": "alb",
      "to": "edge_fn"
    },
    {
      "id": "e_alb_data",
      "mechanism": "listener-target",
      "from": "alb",
      "to": "data_fn"
    },
    {
      "id": "e_cert_alb",
      "mechanism": "cert-attach",
      "from": "cert",
      "to": "alb"
    },
    {
      "id": "e_zone_alb",
      "mechanism": "dns-alias",
      "from": "zone",
      "to": "alb",
      "props": {
        "name": "api.example.com"
      }
    },
    {
      "id": "e_repo_data",
      "mechanism": "image-source",
      "from": "repo",
      "to": "data_fn"
    },
    {
      "id": "e_data_db",
      "mechanism": "network-access",
      "from": "data_fn",
      "to": "db"
    },
    {
      "id": "e_role_data",
      "mechanism": "assume-role",
      "from": "data_role",
      "to": "data_fn"
    },
    {
      "id": "e_role_uploads",
      "mechanism": "grant",
      "from": "data_role",
      "to": "uploads",
      "props": {
        "level": "readwrite"
      }
    },
    {
      "id": "e_role_audit",
      "mechanism": "grant",
      "from": "data_role",
      "to": "audit"
    }
  ]
}
