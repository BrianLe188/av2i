PORT=3000
# Leave empty to use a local sql.js file (apps/api/data/av2i.sqlite).
# DATABASE_URL=postgres://av2i:av2i@localhost:5432/av2i
# SQLITE_PATH=data/av2i.sqlite

# GitHub OAuth app: https://github.com/settings/developers -> New OAuth App
#   Homepage URL:              http://localhost:5173
#   Authorization callback URL: http://localhost:5173/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Signs the session cookie. Required in production; any long random string.
SESSION_SECRET=

# Defaults match the local dev setup; override when deployed.
# GITHUB_CALLBACK_URL=http://localhost:5173/api/auth/github/callback
# WEB_URL=http://localhost:5173

# Local review only: shows a "Continue as dev user" button. Ignored in production.
# DEV_LOGIN=true
